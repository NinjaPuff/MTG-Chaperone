# Local dev DB — use your existing Windows Postgres (has test data) or Docker on 5433:
# Windows (test fixtures): postgresql://postgres:password@localhost:5432/mtgleague
# Docker (empty/isolated):  postgresql://user:password@localhost:5433/mtgleague
DATABASE_URL=postgresql://postgres:password@localhost:5432/mtgleague
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CALLBACK_URL=http://localhost:3000/api/auth/discord/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
JWT_SECRET=
SESSION_SECRET=
DISCORD_WEBHOOK_URL=
CLIENT_URL=http://localhost:5173
SERVER_PORT=3000

# Optional — Ko-fi link in the site footer (Vite client build; set in client/.env or export before `npm run build`)
# VITE_KOFI_URL=https://ko-fi.com/yourpage
