# Production environment for home-server Docker deployment (Cloudflare Tunnel).
# Copy to .env.production and replace placeholder values.
# .env.production is gitignored — never commit secrets.

NODE_ENV=production
DOMAIN=your-subdomain.example.com

# Cloudflare Tunnel — Zero Trust → Networks → Tunnels → Create → Docker
CLOUDFLARE_TUNNEL_TOKEN=

# Database (must match postgres service in docker-compose.prod.yml)
POSTGRES_USER=user
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=mtgleague
DATABASE_URL=postgresql://user:change-me-to-a-strong-password@postgres:5432/mtgleague

# App
SERVER_PORT=3000
CLIENT_URL=https://your-subdomain.example.com
JWT_SECRET=change-me-to-a-long-random-string

# OAuth — update redirect URIs in Discord/Google developer consoles to match exactly
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CALLBACK_URL=https://your-subdomain.example.com/api/auth/discord/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://your-subdomain.example.com/api/auth/google/callback

# Optional
DISCORD_WEBHOOK_URL=
